Private Sub CaseUnknownKind()
    'A kind the contract does not define raises ERR_CSV_READ.
    Dim Bytes()     As Byte             'One header byte
    Dim Result      As CsvReadResult    'Not filled
    Dim Values()    As String           'Not filled
    Dim Lines()     As Long             'Not filled
    Dim Findings()  As CsvFinding       'Not filled
    Dim ErrorNumber As Long             'Error raised
        BeginCase "reader.unknown-kind"
        ReDim Bytes(0 To 0)
        Bytes(0) = 65
        On Error Resume Next
        ReadCsvBytes Bytes, 1, "Other", Result, Values, Lines, Findings
        ErrorNumber = Err.Number
        On Error GoTo 0
        Check ErrorNumber = ERR_CSV_READ, "error " & ErrorNumber & ", expected ERR_CSV_READ"

End Sub


Private Sub CaseMissingFile()
    'A file that does not exist raises ERR_CSV_READ.
    Dim Result      As CsvReadResult    'Not filled
    Dim Values()    As String           'Not filled
    Dim Lines()     As Long             'Not filled
    Dim Findings()  As CsvFinding       'Not filled
    Dim ErrorNumber As Long             'Error raised
        BeginCase "reader.missing-file"
        On Error Resume Next
        ReadCsvFile TestFolder() & Application.PathSeparator & "K-SACCR_csv_reader_missing.csv", "Trades", Result, Values, Lines, Findings
        ErrorNumber = Err.Number
        On Error GoTo 0
        Check ErrorNumber = ERR_CSV_READ, "error " & ErrorNumber & ", expected ERR_CSV_READ"

End Sub


Private Sub CaseFileRoundTrip()
    'The valid Trades fixture written to a file is read back whole.
    Dim Bytes()     As Byte             'The fixture
    Dim ByteCount   As Long             'Its length
    Dim TargetFile  As String           'The test file
    Dim Result      As CsvReadResult    'What the reader found
    Dim Values()    As String           'The records
    Dim Lines()     As Long             'Their lines
    Dim Findings()  As CsvFinding       'The findings
        On Error GoTo Unexpected
        BeginCase "reader.file-round-trip"
        TargetFile = TestFolder() & Application.PathSeparator & "K-SACCR_csv_reader_test.csv"
        ByteCount = HexToBytes(RoundTripHex(), Bytes)
        WriteTestFile TargetFile, Bytes, ByteCount
        ReadCsvFile TargetFile, "Trades", Result, Values, Lines, Findings
        Check Result.Accepted, "the file was not accepted: " & FindingsText(Result, Findings)
        Check ValuesText(Result, Values) = RoundTripValues(), "values differ from the file"
        Check Lines(Result.RecordCount) = ROUND_TRIP_LAST_LINE, "last record on line " & Lines(Result.RecordCount)
        RemoveTestFile TargetFile
        Exit Sub

Unexpected:
        Fail mCurrentCase, "unexpected error " & Err.Number & ": " & Err.Description
        RemoveTestFile TargetFile

End Sub


Private Sub CaseFileTooLarge()
    'A file larger than the limit is refused from its size alone.
    Dim Bytes()     As Byte             'The fixture
    Dim ByteCount   As Long             'Its length
    Dim TargetFile  As String           'The test file
    Dim Result      As CsvReadResult    'What the reader found
    Dim Values()    As String           'Not filled
    Dim Lines()     As Long             'Not filled
    Dim Findings()  As CsvFinding       'The findings
        On Error GoTo Unexpected
        BeginCase "reader.file-too-large"
        TargetFile = TestFolder() & Application.PathSeparator & "K-SACCR_csv_reader_test.csv"
        ByteCount = HexToBytes(RoundTripHex(), Bytes)
        WriteTestFile TargetFile, Bytes, ByteCount
        ReadCsvFile TargetFile, "Trades", Result, Values, Lines, Findings, ByteCount - 1
        Check FindingsText(Result, Findings) = "CSV-TOO-LARGE|0|0|", "findings [" & FindingsText(Result, Findings) & "]"
        Check Not Result.Accepted And Result.RecordCount = 0, "a file too large was accepted"
        RemoveTestFile TargetFile
        Exit Sub

Unexpected:
        Fail mCurrentCase, "unexpected error " & Err.Number & ": " & Err.Description
        RemoveTestFile TargetFile

End Sub


Private Sub CaseMalformedPath()
    'A path the file system rejects raises ERR_CSV_READ, not its own error.
    Dim Result      As CsvReadResult    'Not filled
    Dim Values()    As String           'Not filled
    Dim Lines()     As Long             'Not filled
    Dim Findings()  As CsvFinding       'Not filled
    Dim ErrorNumber As Long             'Error raised
        BeginCase "reader.malformed-path"
        On Error Resume Next
        ReadCsvFile TestFolder() & Application.PathSeparator & "K-SACCR|<bad>?.csv", "Trades", Result, Values, Lines, Findings
        ErrorNumber = Err.Number
        On Error GoTo 0
        Check ErrorNumber = ERR_CSV_READ, "error " & ErrorNumber & ", expected ERR_CSV_READ"

End Sub


Private Sub CaseSilentEntry()
    'M_Main.ReadCsv_Silent on an accepted and on a rejected file.
    Dim Bytes()     As Byte             'A fixture
    Dim ByteCount   As Long             'Its length
    Dim TargetFile  As String           'The test file
        On Error GoTo Unexpected
        BeginCase "main.read-csv-silent"
        TargetFile = TestFolder() & Application.PathSeparator & "K-SACCR_csv_reader_test.csv"
        ByteCount = HexToBytes(RoundTripHex(), Bytes)
        WriteTestFile TargetFile, Bytes, ByteCount
        Check M_Main.ReadCsv_Silent("Trades", TargetFile) = ROUND_TRIP_RESULT & "; file=" & TargetFile, _
              "accepted file: " & M_Main.ReadCsv_Silent("Trades", TargetFile)
        ByteCount = HexToBytes(RejectedHex(), Bytes)
        WriteTestFile TargetFile, Bytes, ByteCount
        Check M_Main.ReadCsv_Silent("Trades", TargetFile) = REJECTED_RESULT & "; file=" & TargetFile, _
              "rejected file: " & M_Main.ReadCsv_Silent("Trades", TargetFile)
        RemoveTestFile TargetFile
        Exit Sub

Unexpected:
        Fail mCurrentCase, "unexpected error " & Err.Number & ": " & Err.Description
        RemoveTestFile TargetFile

End Sub


'
'------------------------------------------------------------------------------
'
'                                   HELPERS
'
'------------------------------------------------------------------------------
'

Private Function HexToBytes( _
    ByVal HexText As String, _
    ByRef Bytes() As Byte) _
    As Long
    'The bytes of HexText, two hex digits each; returns their number.
    Dim i       As Long    'Byte counter
        HexToBytes = Len(HexText) \ 2
        If HexToBytes = 0 Then
            Erase Bytes
            Exit Function
        End If
        ReDim Bytes(0 To HexToBytes - 1)
        For i = 0 To HexToBytes - 1
            Bytes(i) = CByte("&H" & Mid$(HexText, 2 * i + 1, 2))
        Next i

End Function


Private Function WithBom( _
    ByRef Bytes() As Byte, _
    ByVal ByteCount As Long, _
    ByRef Result() As Byte) _
    As Long
    'Bytes behind a UTF-8 byte-order mark; returns the new length.
    Dim i       As Long    'Byte counter
        ReDim Result(0 To ByteCount + 2)
        Result(0) = &HEF
        Result(1) = &HBB
        Result(2) = &HBF
        For i = 0 To ByteCount - 1
            Result(i + 3) = Bytes(i)
        Next i
        WithBom = ByteCount + 3

End Function


Private Function WithCrLf( _
    ByRef Bytes() As Byte, _
    ByVal ByteCount As Long, _
    ByRef Result() As Byte) _
    As Long
    'Bytes with every line feed preceded by a carriage return; returns the
    'new length.
    Dim i       As Long    'Byte counter
    Dim n       As Long    'Bytes written
        If ByteCount = 0 Then
            Erase Result
            Exit Function
        End If
        ReDim Result(0 To 2 * ByteCount - 1)
        For i = 0 To ByteCount - 1
            If Bytes(i) = 10 Then
                Result(n) = 13
                n = n + 1
            End If
            Result(n) = Bytes(i)
            n = n + 1
        Next i
        WithCrLf = n

End Function


Private Function FindingsText( _
    ByRef Result As CsvReadResult, _
    ByRef Findings() As CsvFinding) _
    As String
    'Every finding as code|line|record|column, one per line.
    Dim f       As Long    'Finding counter
        For f = 1 To Result.FindingCount
            FindingsText = FindingsText & IIf(f > 1, vbLf, "") & FindingText(Findings(f))
        Next f

End Function


Private Function ValuesText( _
    ByRef Result As CsvReadResult, _
    ByRef Values() As String) _
    As String
    'Every value of an accepted file: fields separated by ChrW(31) and
    'records by ChrW(30), control characters no accepted value holds.
    Dim r       As Long    'Record counter
    Dim c       As Long    'Column counter
        For r = 1 To Result.RecordCount
            If r > 1 Then ValuesText = ValuesText & ChrW(30)
            For c = 1 To Result.ColumnCount
                If c > 1 Then ValuesText = ValuesText & ChrW(31)
                ValuesText = ValuesText & Values(r, c)
            Next c
        Next r

End Function


Private Function TestFolder() As String
    'The TEMP folder, or the workbook's folder when TEMP is not set.
        TestFolder = Environ$("TEMP")
        If Len(TestFolder) = 0 Then
            TestFolder = ThisWorkbook.Path
        End If

End Function


Private Sub WriteTestFile( _
    ByVal TargetFile As String, _
    ByRef Bytes() As Byte, _
    ByVal ByteCount As Long)
    'Write the bytes to TargetFile, replacing it.
    Dim FileNumber  As Integer    'File number
        RemoveTestFile TargetFile
        FileNumber = FreeFile
        Open TargetFile For Binary Access Write As #FileNumber
        If ByteCount > 0 Then
            Put #FileNumber, 1, Bytes
        End If
        Close #FileNumber

End Sub


Private Sub RemoveTestFile( _
    ByVal TargetFile As String)
    'Delete a test file when it exists.
        On Error Resume Next
        If Len(TargetFile) > 0 Then
            If Len(Dir$(TargetFile, vbHidden)) > 0 Then
                SetAttr TargetFile, vbNormal
                Kill TargetFile
            End If
        End If
        Err.Clear

End Sub


Private Sub BeginCase( _
    ByVal CaseName As String)
        mCaseCount = mCaseCount + 1
        mCurrentCase = CaseName
        TEST_Suite.Say "CASE=" & CaseName

End Sub


Private Sub Check( _
    ByVal Passed As Boolean, _
    ByVal Detail As String)
        mCheckCount = mCheckCount + 1
        If Not Passed Then
            Fail mCurrentCase, Detail
        End If

End Sub


Private Sub Fail( _
    ByVal CaseName As String, _
    ByVal Detail As String)
        mFailureCount = mFailureCount + 1
        TEST_Suite.Say "FAILURE=" & CaseName & ": " & Detail

End Sub


