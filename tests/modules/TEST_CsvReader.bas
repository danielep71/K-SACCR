Attribute VB_Name = "TEST_CsvReader"
'==============================================================================
' MODULE: TEST_CsvReader
'------------------------------------------------------------------------------
' GENERATED by tools/generate_csv_vba.py from tests/csv. Do not edit:
' change the fixtures or tests/csv/cases.json and regenerate. python
' tools/check.py fails when this file is out of date.
'
' PURPOSE
'   Check that the VBA reader CORE_CsvReader (#207) reports exactly the
'   findings the reference implementation tools/csv_contract.py pinned in
'   tests/csv/expected.json and tests/csv/cases.json: every fixture as
'   written, with a byte-order mark and with CRLF line ends, and every
'   inline case; that an accepted file keeps every value as written; that
'   a file is read from disk and refused when too large from its size;
'   that a missing file, a malformed path and an unknown kind raise
'   ERR_CSV_READ; and that M_Main.ReadCsv_Silent reports an accepted and a
'   rejected file.
'
' USAGE
'   Run TEST_CsvReader.RunCsvReaderTests from the Immediate window. It
'   writes one file to the TEMP folder (K-SACCR_csv_reader_test.csv) and
'   deletes it; it touches no sheet.
'
' COMPATIBILITY
'   The file contents are embedded as hex, so the suite needs no file of
'   the repository at run time. Lines are longer than the house style
'   allows because each holds one piece of data.
'==============================================================================

'------------------------------------------------------------------------------
' MODULE SETTINGS
'------------------------------------------------------------------------------
    Option Explicit
    Option Private Module

'------------------------------------------------------------------------------
' MODULE CONSTANTS
'------------------------------------------------------------------------------
        Private Const EXPECTED_CASES    As Long = 91    'Cases in a complete run
        Private Const EXPECTED_CHECKS   As Long = 195    'Checks in a complete run
        Private Const ROUND_TRIP_LAST_LINE As Long = 11    'Line of the last record of valid/trades.csv
        Private Const ROUND_TRIP_RESULT As String = "RESULT=ACCEPTED; records=9"    'ReadCsv_Silent on it
        Private Const REJECTED_RESULT   As String = "RESULT=REJECTED; findings=16; first=CSV-RANGE|2|1|attachment_rate"    'ReadCsv_Silent on invalid/trades-fields-and-rules.csv

'------------------------------------------------------------------------------
