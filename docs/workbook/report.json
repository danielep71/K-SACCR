{
  "schema": "k-saccr-report",
  "version": 1,
  "description": "The formatted run report of the Export report command (#259): its sections, columns, formats and the rules that decide what the PDF shows; see docs/workbook/REPORT.md.",
  "formats": {
    "date": "yyyy-mm-dd",
    "datetime": "yyyy-mm-dd hh:mm:ss",
    "amount": "#,##0.00",
    "ratio": "0.000000",
    "count": "0",
    "text": "@",
    "measure": "The columns Bank figure, Calculator figure and Absolute difference of a reconciliation take the format of the measure of their row: ratio for the measures in the section's measure_ratios (the ones CORE_Reconcile does not scale and compares by relative tolerance only), amount for every other measure",
    "text_rules": {
      "pdf_amount": "The value to 15 significant digits, rounded half away from zero to two decimals, with a comma between thousands and a point before the decimals; a value that rounds to zero is written without a sign",
      "pdf_ratio": "The same with six decimals and no thousands separator",
      "pdf_count": "The whole number, no separator",
      "pdf_date": "year, month and day from the serial number, four, two and two digits, with a hyphen between",
      "pdf_datetime": "The date, a space and the time as hh:mm:ss, the time rounded to the second"
    },
    "examples": [
      {"kind": "amount", "value": 1234567.891, "text": "1,234,567.89"},
      {"kind": "amount", "value": 0.005, "text": "0.01"},
      {"kind": "amount", "value": -0.004, "text": "0.00"},
      {"kind": "amount", "value": -2.675, "text": "-2.68"},
      {"kind": "amount", "value": 999.995, "text": "1,000.00"},
      {"kind": "amount", "value": 0, "text": "0.00"},
      {"kind": "amount", "value": 50640180.761782, "text": "50,640,180.76"},
      {"kind": "ratio", "value": 0.9585858586, "text": "0.958586"},
      {"kind": "ratio", "value": 1.4, "text": "1.400000"},
      {"kind": "count", "value": 14, "text": "14"},
      {"kind": "date", "value": 46295, "text": "2026-09-30"},
      {"kind": "date", "value": 61, "text": "1900-03-01"},
      {"kind": "datetime", "value": 46352.5340277778, "text": "2026-11-26 12:49:00"},
      {"kind": "datetime", "value": 46352.999994213, "text": "2026-11-27 00:00:00"},
      {"kind": "datetime", "value": 46352.25, "text": "2026-11-26 06:00:00"}
    ]
  },
  "pdf": {
    "paper": "A4",
    "orientation": "landscape",
    "fit_pages_wide": 1,
    "repeat_header_rows": 1,
    "footer": "K-SACCR report - run {run_time} - inputs {inputs} - page {page} of {pages}",
    "charts": "The ten charts of the Dashboard sheet as pictures, on a sheet of their own after the Dashboard tables"
  },
  "refusal": "The rules of ExportEvidence (EvidenceProblem): recalculation pending, a staging validation on Checks, results not those of the current inputs, an output cell edited after the run, a reconciliation of bank figures not current, outputs not recorded",
  "reconciliation_rows": {
    "xlsx": "every row of the sheet",
    "pdf": "Reconciliation of netting sets: every row whose Result is not MATCH, and a line stating how many MATCH rows are left out",
    "pdf_trades": "Reconciliation of trade legs: the rows whose Result is DIFFERENCE, the largest absolute difference first (ties in their order on the sheet), at most pdf_trade_limit of them, and a line stating how many rows are left out; the summary above gives the counts by result (owner's decision of 2026-11-26, after a real portfolio gave a PDF of 163 pages)",
    "pdf_trade_limit": 50,
    "match": "MATCH",
    "difference": "DIFFERENCE"
  },
  "checks_by_code": {
    "no_code": "(none)",
    "severities": ["ERROR", "WARNING", "INFO"],
    "order": "The highest severity of the code (ERROR, then WARNING, then INFO), then the code in ordinal order; the rows of Checks follow in that order, each code's rows in their order on the sheet",
    "pdf": "The summary by code, then at most pdf_rows_per_code rows of each code, in that order, and a line stating how many rows are left out (owner's decision of 2026-11-26)",
    "pdf_rows_per_code": 10
  },
  "sections": [
    {
      "id": "run",
      "sheet": "Run",
      "title": "Run",
      "layout": "key_value",
      "rows": [
        {"key": "run_summary", "label": "Run summary", "kind": "text", "source": "Results run summary (Results C4)"},
        {"key": "results_status", "label": "Status of the results", "kind": "text", "source": "ResultsStatus()"},
        {"key": "reporting_date", "label": "Reporting date", "kind": "date", "source": "Params AsOfDate"},
        {"key": "reporting_ccy", "label": "Reporting currency", "kind": "text", "source": "Params ReportingCcy"},
        {"key": "regime_default", "label": "Default regime", "kind": "text", "source": "Params Regime"},
        {"key": "reference_parameter_set", "label": "Regulatory parameter set", "kind": "text", "source": "REF_SET_ID"},
        {"key": "year_convention", "label": "Days of the year", "kind": "text", "source": "CORE_Engine.YearConventionText"},
        {"key": "calendar", "label": "Calendar", "kind": "text", "source": "CORE_Engine.CalendarText"},
        {"key": "holiday_table", "label": "Closing-day table", "kind": "text", "source": "CORE_Engine.HolidayTableText"},
        {"key": "fx_source", "label": "FX rate source", "kind": "text", "source": "CORE_Engine.FxSourceText"},
        {"key": "inputs", "label": "Input fingerprint", "kind": "text", "source": "CORE_Engine.LastRunInputs"},
        {"key": "outputs", "label": "Output fingerprint", "kind": "text", "source": "stored outputs fingerprint"},
        {"key": "reconciliation", "label": "Reconciliation of netting sets", "kind": "text", "source": "CURRENT, NOT MADE or UNAVAILABLE, as the evidence CSV"},
        {"key": "trade_reconciliation", "label": "Reconciliation of trade legs", "kind": "text", "source": "CURRENT, NOT MADE or UNAVAILABLE, as the evidence CSV"},
        {"key": "units", "label": "Units", "kind": "text", "source": "reporting currency; amounts unscaled unless a table says otherwise"}
      ]
    },
    {
      "id": "dashboard",
      "sheet": "Dashboard",
      "title": "Dashboard",
      "layout": "blocks",
      "blocks_from": "docs/workbook/dashboard.json",
      "note": "Every block of the Dashboard's data table, as a small table with its row labels and column headers; amounts are in units of the reporting currency (#810), as Dashboard_Scale names in the table's title",
      "charts_sheet": "Charts",
      "charts_in": ["pdf"]
    },
    {
      "id": "totals",
      "sheet": "Totals",
      "title": "Totals and status per regime",
      "layout": "table",
      "source": "the TOTAL CRR and TOTAL BCBS rows of Results",
      "unit": "reporting currency, unscaled",
      "columns": [
        {"header": "Regime", "kind": "text"},
        {"header": "V (sum MtM)", "kind": "amount"},
        {"header": "C (VM + NICA)", "kind": "amount"},
        {"header": "RC", "kind": "amount"},
        {"header": "AddOn IR", "kind": "amount"},
        {"header": "AddOn FX", "kind": "amount"},
        {"header": "AddOn CR", "kind": "amount"},
        {"header": "AddOn EQ", "kind": "amount"},
        {"header": "AddOn CO", "kind": "amount"},
        {"header": "AddOn OT", "kind": "amount"},
        {"header": "AddOn aggregate", "kind": "amount"},
        {"header": "PFE", "kind": "amount"},
        {"header": "EAD", "kind": "amount"},
        {"header": "Status", "kind": "text"}
      ]
    },
    {
      "id": "results",
      "sheet": "Results",
      "title": "Results per netting set",
      "layout": "table",
      "source": "Results (header at Results_Header), every row down to the last TOTAL row",
      "header_name": "Results_Header",
      "unit": "reporting currency, unscaled",
      "columns": [
        {"header": "NettingSetID", "kind": "text"},
        {"header": "Counterparty", "kind": "text"},
        {"header": "Regime", "kind": "text"},
        {"header": "Margined", "kind": "text"},
        {"header": "Trades used", "kind": "count"},
        {"header": "MPOR (BD)", "kind": "count"},
        {"header": "V (sum MtM)", "kind": "amount"},
        {"header": "C (VM + NICA)", "kind": "amount"},
        {"header": "RC", "kind": "amount"},
        {"header": "AddOn IR", "kind": "amount"},
        {"header": "AddOn FX", "kind": "amount"},
        {"header": "AddOn CR", "kind": "amount"},
        {"header": "AddOn EQ", "kind": "amount"},
        {"header": "AddOn CO", "kind": "amount"},
        {"header": "AddOn OT", "kind": "amount"},
        {"header": "AddOn aggregate", "kind": "amount"},
        {"header": "Multiplier", "kind": "ratio"},
        {"header": "PFE", "kind": "amount"},
        {"header": "Alpha", "kind": "ratio"},
        {"header": "EAD margined", "kind": "amount"},
        {"header": "EAD cap (unmargined)", "kind": "amount"},
        {"header": "EAD", "kind": "amount"},
        {"header": "Cap applied", "kind": "text"},
        {"header": "C (cap basis)", "kind": "amount"},
        {"header": "RC (cap basis)", "kind": "amount"},
        {"header": "AddOn unmargined", "kind": "amount"},
        {"header": "Multiplier (cap basis)", "kind": "ratio"},
        {"header": "Status", "kind": "text"}
      ]
    },
    {
      "id": "checks",
      "sheet": "Checks",
      "title": "Checks by code",
      "layout": "summary_and_table",
      "source": "Checks (header at Checks_Header)",
      "header_name": "Checks_Header",
      "summary_columns": [
        {"header": "Code", "kind": "text"},
        {"header": "Severity", "kind": "text"},
        {"header": "Rows", "kind": "count"}
      ],
      "columns": [
        {"header": "Severity", "kind": "text"},
        {"header": "Sheet", "kind": "text"},
        {"header": "Row", "kind": "count"},
        {"header": "Reference", "kind": "text"},
        {"header": "Message", "kind": "text"},
        {"header": "Origin", "kind": "text"},
        {"header": "Code", "kind": "text"},
        {"header": "Field", "kind": "text"}
      ]
    },
    {
      "id": "reconciliation",
      "sheet": "Reconciliation",
      "title": "Reconciliation of netting sets",
      "layout": "summary_and_table",
      "source": "Reconciliation (header at Reconciliation_Header); summary in Reconciliation C4",
      "header_name": "Reconciliation_Header",
      "unit": "units of the reporting currency, the bank's figures multiplied by the scale of the settings; ratios are not scaled",
      "optional": true,
      "measure_ratios": ["Multiplier"],
      "columns": [
        {"header": "NettingSetID", "kind": "text"},
        {"header": "Bank row", "kind": "count"},
        {"header": "Bank regime", "kind": "text"},
        {"header": "Calculator regime", "kind": "text"},
        {"header": "Calculator status", "kind": "text"},
        {"header": "Measure", "kind": "text"},
        {"header": "Bank figure (amounts in units)", "kind": "measure"},
        {"header": "Calculator figure", "kind": "measure"},
        {"header": "Absolute difference", "kind": "measure"},
        {"header": "Relative difference", "kind": "ratio"},
        {"header": "Result", "kind": "text"},
        {"header": "Note", "kind": "text"}
      ]
    },
    {
      "id": "trade_reconciliation",
      "sheet": "TradeReconciliation",
      "title": "Reconciliation of trade legs",
      "layout": "summary_and_table",
      "source": "TradeReconciliation (header at TradeReconciliation_Header); summary in TradeReconciliation C4",
      "header_name": "TradeReconciliation_Header",
      "unit": "units of the reporting currency, the bank's figures multiplied by the scale of the settings; ratios are not scaled",
      "optional": true,
      "measure_ratios": ["M", "Supervisory duration", "Supervisory delta", "MF unmargined", "MF margined"],
      "columns": [
        {"header": "TradeID", "kind": "text"},
        {"header": "Bank row", "kind": "count"},
        {"header": "NettingSetID", "kind": "text"},
        {"header": "Asset class", "kind": "text"},
        {"header": "Calculator status", "kind": "text"},
        {"header": "Measure", "kind": "text"},
        {"header": "Bank figure (amounts in units)", "kind": "measure"},
        {"header": "Calculator figure", "kind": "measure"},
        {"header": "Absolute difference", "kind": "measure"},
        {"header": "Relative difference", "kind": "ratio"},
        {"header": "Result", "kind": "text"},
        {"header": "Note", "kind": "text"},
        {"header": "Economic trade ID", "kind": "text"}
      ]
    }
  ]
}
