            MinExclusive        As Double     'Values must be above it
            HasMax              As Boolean    'MaxValue applies
            MaxValue            As Double     'Largest allowed value
        End Type

    'One rule between fields of a record. "when": the Required columns must
    'be filled when every WhenColumns field equals its WhenValues value, and
