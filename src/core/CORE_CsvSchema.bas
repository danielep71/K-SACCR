' TYPES
'------------------------------------------------------------------------------
    'One column of a file.
        Public Type CsvColumn
            ColumnName          As String     'CSV column name
            Kind                As String     'id, text, code, flag, currency, integer, number or date
            Required            As Boolean    'A blank value is an error
