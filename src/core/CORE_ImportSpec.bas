'==============================================================================
' MODULE: CORE_ImportSpec
'------------------------------------------------------------------------------
' GENERATED by tools/generate_csv_vba.py from docs/csv/contract.json. Do not
' edit: change the contract or tools/import_spec.py and regenerate. python
' tools/check.py fails when this file is out of date.
'
' PURPOSE
'   Hold the CSV import specification (#473) for the workbook's export: the
'   page docs/csv/K-SACCR_Import_Specification.html, character for
'   character, and the contract's example NettingSets and Trades files that
'   the page shows.
'
' PUBLIC SURFACE
'   None outside this VBA project. ImportSpecificationText returns the page,
'   lines ended by a line feed; ImportSpecExample returns the example file
'   of "NettingSets" or "Trades", "" for another kind. IMPORT_SPEC_FILE is
'   the file name the export offers and IMPORT_SPEC_BYTES the page's length
'   in UTF-8 bytes, which the tests compare with the page they encode.
'
' COMPATIBILITY
'   Excel VBA; no references beyond the defaults. Characters outside
'   printable ASCII are written as ChrW calls, so the module is the same in
'   every code page.
'==============================================================================

'------------------------------------------------------------------------------
' MODULE SETTINGS
'------------------------------------------------------------------------------
    Option Explicit
    Option Private Module

'------------------------------------------------------------------------------
' MODULE CONSTANTS
'------------------------------------------------------------------------------
        Public Const IMPORT_SPEC_FILE   As String = "K-SACCR_Import_Specification_v1.html"    'File name the export offers
        Public Const IMPORT_SPEC_BYTES  As Long = 33410    'Length of the page in UTF-8 bytes


Public Function ImportSpecificationText() As String
'
'==============================================================================
' PURPOSE
'   The import specification page, lines ended by a line feed.
'==============================================================================
'
    Dim Page    As String    'The page so far

        AppendPart1 Page
        AppendPart2 Page
        AppendPart3 Page
        AppendPart4 Page
        AppendPart5 Page
        AppendPart6 Page
        ImportSpecificationText = Page

End Function


Public Function ImportSpecExample( _
    ByVal Kind As String) _
    As String
'
'==============================================================================
' PURPOSE
'   The example file of Kind, "NettingSets" or "Trades", as the page
'   shows it: the header and the example records, each line ended by a
'   line feed; "" for another kind.
'==============================================================================
'
    Dim Text    As String    'The file so far

        Select Case Kind
            Case "NettingSets"
                Text = Text & "netting_set_id;counterparty;margined;clearing_role;remargin_period_business_days;large_or_illiquid;margin_disputes;mpor_override_business_days;variation_margin_net_amount;independent_collateral_net_am"
                Text = Text & "ount;threshold_amount;minimum_transfer_amount;alpha_factor;regime_override;margin_agreements;qccp;ccp_retains_variation_margin" & vbLf
                Text = Text & "NS-001;Synthetic Bank, London;Y;N;1;N;N;;-150000;250000;0;100000;;;;;" & vbLf
                Text = Text & "00731;""M" & ChrW(252) & "ller & S" & ChrW(248) & "n """"Nord""""; <Example> AG"";N;;;;;;;;;;;BCBS;;;" & vbLf
                Text = Text & "NS-CCP;Example CCP;Y;CCP;1;N;N;;0;0;0;0;;;;Y;N" & vbLf
            Case "Trades"
                Text = Text & "trade_id;netting_set_id;asset_class;sub_class;risk_factor;instrument;direction;option_type;nature;hedging_set_label;notional_amount;notional_currency;market_value_amount;market_value_currency;start_da"
                Text = Text & "te;end_date;maturity_date;option_expiry_date;underlying_price;strike_price;lambda_price;attachment_rate;detachment_rate;economic_trade_id;mtm_leg;settlement_type;next_reset_date;comment" & vbLf
                Text = Text & "TRD-101-IR;NS-001;IR;;USD;Linear;Short;;;;5000000;USD;-1200000;EUR;2026-10-01;2029-10-01;2029-10-01;;;;;;;TRD-101;Y;;;""Cross-currency swap; MtM on this leg""" & vbLf
                Text = Text & "TRD-101-FX;NS-001;FX;;EUR/USD;Linear;Long;;;;5000000;USD;0;;;;2029-10-01;;;;;;;TRD-101;N;;;" & vbLf
                Text = Text & "000245;00731;EQ;SINGLE;ACME-EQ;Option;Long;Call;;;1000000;EUR;35000;;;;2028-03-31;2027-03-31;100;110;;;;;;;;" & vbLf
                Text = Text & "TRD-STM-1;00731;IR;;EUR;Linear;Short;;;;3000000;EUR;0;;;;2029-12-31;;;;;;;;;STM;2026-12-31;""Settled to market, """"STM""""""" & vbLf
                Text = Text & "TRD-CCP-1;NS-CCP;IR;;GBP;Linear;Long;;;;2000000;GBP;-15000;;;;2028-06-30;;;;;;;;;;;Cleared swap" & vbLf
        End Select
        ImportSpecExample = Text

End Function


