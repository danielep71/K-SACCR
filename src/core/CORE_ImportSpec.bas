Private Sub AppendPart2( _
    ByRef Page As String)
'
'   Piece 2 of 6 of the page.
'
        Page = Page & "<tr><td>NettingSets</td><td>NettingSets</td><td><code>netting_set_id</code></td><td class=""num"">10,000</td><td><code>K-SACCR_NettingSets_v1.csv</code></td></tr>" & vbLf
        Page = Page & "<tr><td>Trades</td><td>Trades</td><td><code>trade_id</code></td><td class=""num"">100,000</td><td><code>K-SACCR_Trades_v1.csv</code></td></tr>" & vbLf
        Page = Page & "</tbody>" & vbLf
        Page = Page & "</table>" & vbLf
        Page = Page & "</section>" & vbLf
        Page = Page & "<section id=""format"">" & vbLf
        Page = Page & "<h2>File format</h2>" & vbLf
        Page = Page & "<ul>" & vbLf
        Page = Page & "<li><strong>Encoding.</strong> UTF-8, with or without a byte-order mark. A file that is not valid UTF-8, or that contains a NUL character, is rejected. Save the file as UTF-8 text; any language may be"
        Page = Page & " used in a text field.</li>" & vbLf
        Page = Page & "<li><strong>Delimiter.</strong> Fields are separated by a semicolon, <code>;</code>. A file whose header is one field holding commas or tabs was saved with another delimiter and is rejected.</li>" & vbLf
        Page = Page & "<li><strong>Quoting.</strong> A field that contains <code>;</code>, a double quote or a line break is enclosed in double quotes, <code>&quot;</code>, and a quote inside it is written twice: <code>&quo"
        Page = Page & "t;A &quot;&quot;B&quot;&quot;&quot;</code> reads <code>A &quot;B&quot;</code>. Quotes enclose a whole field only: a quote inside an unquoted field, text after a closing quote, or a quoted field left o"
        Page = Page & "pen at the end of the file is a syntax error.</li>" & vbLf
        Page = Page & "<li><strong>Line endings.</strong> Records are separated by CRLF or LF; the last record may end without one. A carriage return anywhere else outside a quoted field is an error.</li>" & vbLf
        Page = Page & "<li><strong>Multi-line fields.</strong> A quoted field may span several lines; only text fields accept a line break. A finding names the line on which its record starts and the record number, counted "
        Page = Page & "from 1 after the header.</li>" & vbLf
        Page = Page & "<li><strong>Numbers.</strong> Decimal point <code>.</code>, no thousands separator, no <code>+</code> sign, no leading zero (<code>0.5</code> is a number, <code>007.5</code> is not), an optional expon"
        Page = Page & "ent (<code>1.25e6</code>); at most 15 significant digits, so that a value is never rounded when it is read. <code>1,5</code> and <code>1.000,00</code> are rejected.</li>" & vbLf
        Page = Page & "<li><strong>Dates.</strong> <code>yyyy-mm-dd</code>, from <code>1950-01-01</code> to <code>2200-12-31</code>; <code>31/03/2027</code> and serial numbers are rejected.</li>" & vbLf
        Page = Page & "<li><strong>Spaces.</strong> Spaces belong to the field. A value of a type other than text with a leading or trailing space is rejected, never trimmed.</li>" & vbLf
        Page = Page & "<li><strong>No formulas.</strong> Text that starts with <code>=</code>, <code>+</code>, <code>-</code>, <code>@</code>, a tab or a carriage return is rejected, so that no field becomes a formula on a "
        Page = Page & "sheet. A negative number is a value, not a formula.</li>" & vbLf
        Page = Page & "<li><strong>Excel.</strong> Excel's own CSV save writes numbers and dates in the format of the computer's locale, such as a decimal comma or a day-first date, and in some locales separates fields with"
        Page = Page & " commas, so such a file is rejected. Write the file with a program that follows these rules.</li>" & vbLf
        Page = Page & "</ul>" & vbLf
        Page = Page & "</section>" & vbLf
        Page = Page & "<section id=""header"">" & vbLf
        Page = Page & "<h2>Header</h2>" & vbLf
        Page = Page & "<p>The first record is the header. It names every column of the file exactly once, in any order, with the exact lower-case names below; names are case-sensitive. A missing, unknown or repeated column "
        Page = Page & "rejects the file before any record is read. There are no optional columns: an optional field is a column whose value may be blank. The column set is the contract version: a file of another version is "
        Page = Page & "never mapped by guessing what a column means.</p>" & vbLf
        Page = Page & "</section>" & vbLf
        Page = Page & "<section id=""types"">" & vbLf
        Page = Page & "<h2>Value types</h2>" & vbLf
        Page = Page & "<table>" & vbLf
        Page = Page & "<thead><tr><th>Type</th><th>Written as</th><th>Rules</th></tr></thead>" & vbLf
        Page = Page & "<tbody>" & vbLf
        Page = Page & "<tr><td><code>id</code></td><td>Text, read as text, so leading zeros are kept (<code>00123</code>)</td><td>At most 64 characters; no <code>|</code>, <code>#</code>; no control character. Keys are comp"
        Page = Page & "ared case-insensitively.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>text</code></td><td>Text</td><td>At most 500 characters; line breaks allowed, other control characters not.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>code</code></td><td>One of the listed values</td><td>Exact spelling and case: <code>Linear</code>, not <code>linear</code>.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>flag</code></td><td><code>Y</code>, <code>N</code></td><td>Exact; <code>y</code>, <code>Yes</code>, <code>TRUE</code>, <code>1</code> are rejected.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>currency</code></td><td>Three capital letters</td><td><code>EUR</code>, not <code>eur</code>.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>integer</code></td><td><code>-?digits</code></td><td>No sign <code>+</code>, no leading zero, no decimal point.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>number</code></td><td><code>-?digits[.digits][e" & ChrW(177) & "digits]</code></td><td>As under Numbers above; a non-zero magnitude from 2.2250738585072014e-308 to 9.99999999999999e307.</td></tr>" & vbLf
        Page = Page & "<tr><td><code>date</code></td><td><code>yyyy-mm-dd</code></td><td>A calendar date within the range above.</td></tr>" & vbLf
        Page = Page & "</tbody>" & vbLf
        Page = Page & "</table>" & vbLf
        Page = Page & "</section>" & vbLf
        Page = Page & "<section id=""blanks"">" & vbLf
        Page = Page & "<h2>Blank fields, empty files and limits</h2>" & vbLf
        Page = Page & "<ul>" & vbLf
        Page = Page & "<li>A <strong>blank field</strong> is an empty one. A required field must not be blank; an optional blank field takes the meaning given under <em>Blank means</em>, which is the sheet's.</li>" & vbLf
        Page = Page & "<li>A <strong>blank record</strong>, whose fields are all empty, and an <strong>empty line</strong> are errors.</li>" & vbLf
        Page = Page & "<li>A <strong>header-only file</strong> is valid and holds no record. Committing it never clears the input sheet: a staging sheet without rows leaves its input sheet as it is.</li>" & vbLf
        Page = Page & "<li>A file is accepted or rejected <strong>as a whole</strong>: one finding rejects every record, and no record is dropped or truncated.</li>" & vbLf
        Page = Page & "</ul>" & vbLf
        Page = Page & "<table><thead><tr><th>File</th><th>Records per file</th></tr></thead><tbody><tr><td>NettingSets</td><td class=""num"">10,000</td></tr><tr><td>Trades</td><td class=""num"">100,000</td></tr></tbody></table>" & vbLf
        Page = Page & "<p>A file of more than 134,217,728 bytes (128 MiB), a byte-order mark included, is rejected from its size alone. These limits are the import's. The sheets' drop-down lists cover only the rows a user t"

End Sub


